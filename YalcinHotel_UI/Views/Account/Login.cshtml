@model AccountLoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}
<section class="account-page">
    <div class="account-card">
        <span class="eyebrow">TAHITI RESORT &amp; SPA</span>
        <h1>Tekrar hoş geldiniz.</h1>
        <p class="account-lead">Rezervasyonunuzu sürdürmek ve profilinizi yönetmek için hesabınıza giriş yapın.</p>
        @if (TempData["PasswordResetMessage"] is string resetMessage) { <div class="site-alert"><i class="fa-solid fa-circle-info"></i> @resetMessage</div> }
        <form asp-action="Login" method="post" class="account-form">
            @Html.AntiForgeryToken()<input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
            <div class="field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" type="email" autocomplete="email" placeholder="ornek@mail.com" /><span asp-validation-for="Email"></span></div>
            <div class="field"><label asp-for="Password">Şifre</label><input asp-for="Password" autocomplete="current-password" placeholder="Şifreniz" /><span asp-validation-for="Password"></span></div>
            <label class="remember-option"><input asp-for="RememberMe" /> Bu cihazda oturumumu açık tut</label>
            <button class="btn btn-gold" type="submit">Giriş Yap <i class="fa-solid fa-arrow-right"></i></button>
        </form>
        <div class="account-switch forgot-password-link"><a asp-action="ForgotPassword">Şifrenizi mi unuttunuz?</a></div>
        <div class="account-switch">Henüz hesabınız yok mu? <a asp-action="Register">Kayıt olun</a></div>
    </div>
    <div class="account-aside"><span class="eyebrow">YALÇIN HOTEL · BORA BORA</span><h2>Gününüzü<br />maviye bırakın.</h2><p>Bir sonraki ada kaçamağınız burada başlıyor.</p></div>
</section>
