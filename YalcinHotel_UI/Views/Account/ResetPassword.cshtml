@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre";
}
<section class="account-page">
    <div class="account-card">
        <span class="eyebrow">HESAP GÜVENLİĞİ</span>
        <h1>Yeni şifrenizi belirleyin.</h1>
        <p class="account-lead">Yeni şifreniz en az 8 karakter olmalıdır.</p>
        <form asp-action="ResetPassword" method="post" class="account-form">
            @Html.AntiForgeryToken()<input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
            <div class="field"><label asp-for="Password">Yeni şifre</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
            <div class="field"><label asp-for="ConfirmPassword">Yeni şifre tekrarı</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
            <button class="btn btn-gold" type="submit">Şifremi yenile <i class="fa-solid fa-check"></i></button>
        </form>
    </div>
    <div class="account-aside"><span class="eyebrow">YALÇIN HOTEL</span><h2>Yeni bir<br />başlangıç.</h2><p>Şifrenizi belirleyip hesabınıza güvenle giriş yapın.</p></div>
</section>
