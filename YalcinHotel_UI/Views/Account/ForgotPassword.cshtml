@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}
<section class="account-page">
    <div class="account-card">
        <span class="eyebrow">HESAP GÜVENLİĞİ</span>
        <h1>Şifrenizi yenileyin.</h1>
        <p class="account-lead">Hesabınıza ait e-posta adresini girin. Size süreli bir yenileme bağlantısı hazırlayalım.</p>
        @if (TempData["PasswordResetMessage"] is string message)
        {
            <div class="site-alert"><i class="fa-solid fa-circle-info"></i> @message</div>
        }
        @if (TempData["DevelopmentResetLink"] is string resetLink)
        {
            <div class="reset-link-preview"><strong>Yerel geliştirme sıfırlama bağlantısı</strong><a href="@resetLink">Şifre yenileme sayfasını aç</a><small>Bu bağlantı 30 dakika geçerlidir.</small></div>
        }
        <form asp-action="ForgotPassword" method="post" class="account-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
            <div class="field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" type="email" autocomplete="email" placeholder="ornek@mail.com" /><span asp-validation-for="Email"></span></div>
            <button class="btn btn-gold" type="submit">Yenileme bağlantısı al <i class="fa-solid fa-arrow-right"></i></button>
        </form>
        <div class="account-switch"><a asp-action="Login">Giriş sayfasına dön</a></div>
    </div>
    <div class="account-aside"><span class="eyebrow">YALÇIN HOTEL</span><h2>Güvenle<br />devam edin.</h2><p>Hesap erişiminizi güvenli bir bağlantıyla geri kazanın.</p></div>
</section>
