@{
    ViewData["Title"] = "Bağlantı Geçersiz";
}
<section class="account-page">
    <div class="account-card">
        <span class="eyebrow">HESAP GÜVENLİĞİ</span>
        <h1>Bağlantı geçersiz veya süresi dolmuş.</h1>
        <p class="account-lead">Yeni bir şifre yenileme bağlantısı isteyip tekrar deneyebilirsiniz.</p>
        <a class="btn btn-gold" asp-action="ForgotPassword">Yeni bağlantı iste <i class="fa-solid fa-arrow-right"></i></a>
    </div>
    <div class="account-aside"><span class="eyebrow">YALÇIN HOTEL</span><h2>Yardım<br />her zaman yakın.</h2><p>Yeni bir yenileme bağlantısıyla hesabınıza erişin.</p></div>
</section>
