@model List<CurrentGuestRowViewModel> // Bu sayfa, şu anda otelde konaklayan misafirlerin bilgilerini görüntülemek için kullanılan bir Razor View sayfasıdır. Model olarak, CurrentGuestRowViewModel sınıfının bir listesi kullanılır. Bu model, her bir misafirin adını, e-posta adresini, telefon numarasını, rezervasyon yapılan oda başlığını, giriş ve çıkış tarihlerini ve konuk sayısını içerir. Bu bilgiler, kullanıcıya oteldeki mevcut konaklamalar hakkında bilgi sağlamak için kullanılabilir.
@{
    ViewData["Title"] = "Konaklayan Misafirler";
    Layout = "_LayoutAdmin";
}
<section class="admin-page-heading"><div><span class="admin-kicker">BUGÜNKÜ KONAKLAMALAR</span><h1>Şu an konaklayanlar</h1><p>Onaylı rezervasyonu bugün devam eden misafirler.</p></div><a class="btn btn-outline" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Müşteri yönetimine dön</a></section>
<div class="card"><div class="card-header"><h2 class="card-title">Konaklayan misafirler</h2><span class="admin-count">@Model.Count konaklama</span></div><div class="card-body table-responsive">
    @if (Model.Count == 0)
    {
        <div class="admin-empty"><i class="fa-solid fa-person-shelter"></i><h3>Şu an konaklayan misafir yok</h3><p>Bugün devam eden onaylı rezervasyon bulunmuyor.</p></div>
    }
    else
    {
        <table class="table"><thead><tr><th>MİSAFİR</th><th>ODA</th><th>TELEFON</th><th>GİRİŞ</th><th>ÇIKIŞ</th><th>KİŞİ</th></tr></thead><tbody>
        @foreach (var guest in Model)
        {
            <tr><td><strong>@guest.Name</strong><small class="table-subline">@guest.Email</small></td><td>@guest.RoomTitle</td><td>@guest.Phone</td><td>@guest.CheckIn.ToString("dd.MM.yyyy")</td><td>@guest.CheckOut.ToString("dd.MM.yyyy")</td><td>@guest.GuestCount</td></tr>
        }
        </tbody></table>
    }
</div></div>
