<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yalçın Hotel</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @await Component.InvokeAsync("_LayoutNavbarViewComponentPartial")
    <main>
        @RenderBody()
    </main>
    @await Component.InvokeAsync("_LayoutFooterViewComponentPartial")
    @await Component.InvokeAsync("_LayoutScriptViewComponentPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
