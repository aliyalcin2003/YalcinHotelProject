<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yalçın Hotel</title>
    @* Seçilen temayı CSS yüklenmeden uygular; böylece sayfa açılırken tema parlaması olmaz. *@
    <script>
        document.documentElement.dataset.theme = localStorage.getItem("yalcin-hotel-theme") || "light";
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @await Component.InvokeAsync("_LayoutNavbarViewComponentPartial")
    <main>
        @RenderBody() @* RenderBody: Bu yöntem, layout sayfasının içeriğini yerleştirmek için kullanılır. Her sayfa, layout'un belirli bir bölümüne kendi içeriğini ekler. *@
    </main>
    @await Component.InvokeAsync("_LayoutFooterViewComponentPartial") @*@await:  ASP.NET Core (Razor) mimarisinde asenkron (async) bir işlemi web sayfasını kilitlemeden arka planda beklemek için kullanılır.*@
    @await Component.InvokeAsync("_LayoutScriptViewComponentPartial")
    @await RenderSectionAsync("Scripts", required: false) @* RenderSectionAsync: Bu yöntem, layout sayfasının belirli bir bölümüne ek scriptleri yerleştirmek için kullanılır. Her sayfa, layout'un belirli bir bölümüne kendi scriptlerini ekleyebilir. *@
</body>
</html>
