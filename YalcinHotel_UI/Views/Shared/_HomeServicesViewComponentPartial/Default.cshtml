@model IEnumerable<Service>
@* IEnumerable: Veriyi belleğe hemen yüklemeyen, sadece sırayla okunabilen (foreach'e uygun) salt okunur koleksiyon.*@
<section class="services-section">
    <div class="section-heading services-heading"><span class="eyebrow">KONFORUNUZ İÇİN</span><h2>Hizmetlerimiz</h2><p>Konaklamanızı özel kılacak olanaklarımızı keşfedin.</p></div>
    <div class="service-grid">
        @foreach (var item in Model ?? Enumerable.Empty<Service>())
        {
            <article class="service-card @(item.IsActive ? "service-active" : "service-inactive")">
                @if (!string.IsNullOrWhiteSpace(item.IconUrl))
                {
                    <i class="@item.IconUrl" aria-hidden="true"></i>
                }
                <h3>@item.Title</h3>
                <p>@item.Description</p>
                @if (item.IsActive)
                {
                    <span class="service-open-badge"><i class="fa-solid fa-circle-check"></i> Aktif</span>
                }
                else
                {
                    <span class="service-closed-badge"><i class="fa-regular fa-clock"></i> Geçici süreyle kapalıdır</span>
                }
            </article>
        }
    </div>
</section>
