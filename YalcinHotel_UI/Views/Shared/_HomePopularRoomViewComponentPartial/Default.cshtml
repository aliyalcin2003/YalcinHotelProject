@model List<ResultRoomDTO>
    <section class="rooms-section">
    <div class="section-heading"><span class="eyebrow">MISAFIRLERIN FAVORISI</span><h2>Popüler odalarımız</h2><p>Tahiti'de unutulmaz günler için özenle hazırlanan süitler.</p></div>
    <div class="room-grid">
        @foreach (var item in Model ?? new List<ResultRoomDTO>())
        {
            <article class="room-card">
                <div class="room-image-wrap">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" /> }<span class="room-tag">MISAFIR FAVORISI</span></div>
                <div class="room-info"><div class="room-meta"><span><i class="fa-solid fa-user-group"></i> @item.Capacity kişi</span><span><i class="fa-solid fa-star"></i> 5.0</span></div><h3>@item.Title</h3><p>@item.Description</p><div class="room-card-bottom"><strong class="price">@item.Price.ToString("C0") <small>/ gece</small></strong>
                    <a class="room-link" asp-controller="Reservation" asp-action="Create">Seç <i class="fa-solid fa-arrow-right"></i></a></div>
                </div>
            </article>
        }
    </div>
</section>
