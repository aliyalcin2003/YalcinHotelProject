@model ServiceManagementViewModel
@{
    ViewData["Title"] = "Hizmet Ekle";
    Layout = "_LayoutAdmin";
}
<section class="admin-page-heading"><div><span class="admin-kicker">OTEL HİZMETLERİ</span><h1>Hizmet ekle</h1><p>Yeni hizmet sitede aktif olarak yayınlanır.</p></div><a class="btn btn-outline" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Listeye dön</a></section>
<div class="card admin-form-card"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group"><label asp-for="Title">Hizmet adı</label><input asp-for="Title" class="form-control" placeholder="Örn. Spa &amp; Wellness" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="form-group"><label asp-for="Description">Açıklama</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="form-group"><label asp-for="IconUrl">Font Awesome ikon sınıfı</label><input asp-for="IconUrl" class="form-control" placeholder="fa-solid fa-spa" /><span asp-validation-for="IconUrl" class="text-danger"></span><small class="form-help">Örnek: fa-solid fa-spa veya fa-solid fa-utensils</small></div>
</div><div class="card-footer"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-check"></i> Hizmeti kaydet</button></div></form></div>
