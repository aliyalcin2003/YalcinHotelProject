@model List<ResultSliderDTO>
@{
    ViewData["Title"] = "Slider listesi";
    Layout = "_LayoutAdmin";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Slider kayitlari</h3>
        <a class="btn btn-primary btn-sm" asp-controller="Slider" asp-action="Create"><i class="fas fa-plus"></i> Yeni slider</a>
    </div>
    <div class="card-body table-responsive">
        @if (TempData["SliderMessage"] is string sliderMessage) { <div class="admin-alert"><i class="fa-solid fa-circle-check"></i> @sliderMessage</div> }
        @if (Model == null || Model.Count == 0)
        {
            <p class="text-muted mb-0">Henuz slider kaydi eklenmemis.</p>
        }
        else
        {
            <table class="table table-bordered table-hover">
                <thead><tr><th>Baslik</th><th>Sayfa</th><th>Gorsel 1</th><th>Gorsel 2</th><th>Aciklama</th><th>Islemler</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td><td>@item.Page</td>
                        <td><img src="@item.ImageUrl1" alt="@item.Title" loading="lazy" style="max-width:140px;max-height:90px;object-fit:cover" /></td>
                        <td>@if (!string.IsNullOrWhiteSpace(item.ImageUrl2)) { <img src="@item.ImageUrl2" alt="@item.Title" loading="lazy" style="max-width:140px;max-height:90px;object-fit:cover" /> }</td>
                        <td>@item.Description</td>
                        <td><div class="table-actions"><a class="btn btn-secondary btn-sm" asp-controller="Slider" asp-action="Edit" asp-route-id="@item.Id"><i class="fa-solid fa-pen"></i> Düzenle</a><form asp-controller="Slider" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu görsel kaydını silmek istiyor musunuz?')"><button type="submit" class="btn btn-danger-soft btn-sm"><i class="fa-regular fa-trash-can"></i> Sil</button></form></div></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
