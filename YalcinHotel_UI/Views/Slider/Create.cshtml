@model CreateSliderDTO
@{
    ViewData["Title"] = "Yeni slider";
    Layout = "_LayoutAdmin";
}
<div class="card card-primary">
    <form asp-controller="Slider" asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Title">Baslik</label><input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Aciklama</label><textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Page">Gosterilecek sayfa</label>
                <select asp-for="Page" class="form-control"><option value="Home">Ana sayfa</option><option value="About">Hakkimizda</option><option value="Contact">Iletisim</option></select>
                <span asp-validation-for="Page" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl1">Ana gorsel URL'si</label><input asp-for="ImageUrl1" type="url" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ImageUrl1" class="text-danger"></span>
                <img id="preview1" alt="Ana gorsel onizleme" class="img-fluid mt-2" style="max-height:220px" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl2">Ikinci gorsel URL'si (istege bagli)</label><input asp-for="ImageUrl2" type="url" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ImageUrl2" class="text-danger"></span>
                <img id="preview2" alt="Ikinci gorsel onizleme" class="img-fluid mt-2" style="max-height:220px" />
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Kaydet</button> <a asp-action="Index" class="btn btn-secondary">Iptal</a></div>
    </form>
</div>
@section Scripts {
<script>
    function bindImagePreview(inputId, previewId) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        input.addEventListener('input', () => preview.src = input.value);
    }
    bindImagePreview('ImageUrl1', 'preview1');
    bindImagePreview('ImageUrl2', 'preview2');
</script>
}